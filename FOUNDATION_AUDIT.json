{
  "version": "8.3.0",
  "cloudflare_workers_ready": true,
  "adapter": "@opennextjs/cloudflare",
  "wrangler_config": true,
  "nodejs_compat": true,
  "open_next_config": true,
  "supabase_sql_change_required": false,
  "changed_files": [
    "package.json",
    "next.config.ts",
    ".gitignore"
  ],
  "new_files": [
    "open-next.config.ts",
    "wrangler.jsonc",
    "public/_headers",
    "docs/CLOUDFLARE_DEPLOY.md"
  ],
  "cloudflare_no_middleware_foundation": true,
  "middleware_entrypoint": false,
  "supabase_auth_mode": "server-action login/logout + server-component getUser",
  "reference_scan_updateSession": [],
  "first_login_session_fix": true,
  "login_revalidate_layout_before_redirect": true,
  "dashboard_force_dynamic": true,
  "dashboard_revalidate_zero": true,
  "home_dashboard_native": true,
  "home_monthly_chart": true,
  "home_owner_snapshot": true,
  "home_recent_activity": true,
  "home_context_selector_in_hero": true,
  "modules_still_locked": [
    "kebun",
    "rencana",
    "realisasi",
    "kalender",
    "laporan",
    "analytics"
  ],
  "activity_module": true,
  "activity_source_table": "operations",
  "direct_activity_crud": true,
  "program_linked_operations_read_only": true,
  "operation_cost_centralized": true,
  "panen_migration": false,
  "fertilizer_program_migration": false
